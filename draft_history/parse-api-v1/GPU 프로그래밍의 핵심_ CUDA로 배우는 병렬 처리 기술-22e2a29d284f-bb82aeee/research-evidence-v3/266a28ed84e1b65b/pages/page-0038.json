  "audit": {
    "additions": [
      {
        "statement": "커널 함수의 괄호(...) 안에 들어가는 매개변수(Argument)들은 cudaMalloc/cudaMemcpy 규칙의 예외이며, 포인터(배열)는 반드시 GPU 메모리여야 하고 배열/거대한 행렬은 크기가 너무 커서 CPU가 커널 발사 시 데이터를 전부 싸들고 던져줄 수 없으므로 사전에 cudaMemcpy로 VRAM에 옮겨두고 커널에는 작업할 데이터가 주소(d_out)에 있다는 정보만 알려준다",
        "limits": "CUDA 커널 매개변수 전달 규칙",
        "kind": "result",
        "claim_status": "observed",
        "source_origin": "research_note",
        "conditions": [],
        "observations": [],
        "parameters": [],
        "measurements": [],
        "element_ids": [
          "p39:e266"
        ]
      },
      {
        "statement": "스칼라(단일 숫자)는 int/float/double/enum 같은 단일 숫자들이 4바이트~8바이트 정도이므로 CPU가 커널 실행/발사(Launch) 명령을 GPU로 쏠 때 cudaMemcpy 없이 실행 명령서 귀퉁이에 포스트잇처럼 값을 붙여 같이 보낼 수 있으며, 이 공간을 Parameter Bank 또는 Constant Memory라고 부른다",
        "limits": "스칼라 전달 방식",
        "kind": "result",
        "claim_status": "observed",
        "source_origin": "research_note",
        "conditions": [],
