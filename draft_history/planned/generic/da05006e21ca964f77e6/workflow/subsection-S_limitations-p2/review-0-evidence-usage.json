  "issues": [
    {
      "section_id": "S_limitations",
      "severity": "error",
      "paragraph_id": "S_limitations_p2",
      "reason": "근거 범위를 벗어난 인과 해석 및 귀속을 포함한다. E00044·E00046은 가중치 사전 업로드 후 실행 시간만 기록하며, E00045는 bias 업로드가 성능 개선에 큰 의미가 없다는 정성적 판단이다. 이 근거들에는 '감소가 실제 가중치 활용 효과라기보다 CUDA 컨텍스트 초기화 웜업 효과일 가능성'이라는 귀속·인과 해석이 직접 기록되어 있지 않다. 해당 해석은 E00070·E00071의 warmup 관련 정성적 관찰과 혼동되어 결합된 것으로 보이며, 현재 근거만으로는 문단 내 귀속을 뒷받침하지 못한다.",
      "evidence_ids": [
        "E00044",
        "E00045",
        "E00046"
      ],
      "review_stage": "evidence_usage",
      "review_request": "review-0-approved-evidence-S_limitations_p2-0"
    },
    {
      "section_id": "S_limitations",
      "severity": "error",
      "paragraph_id": "S_limitations_p2",
      "reason": "근거에 없는 수치·효과를 추가·확대했다. E00070·E00071은 warmup 및 mempool+warmup 조합에 대한 정성적 관찰·추정만 기록하며, '거의 200ms 단축'은 기록자의 정성적 평가로 한계가 명시되어 있다. 문단에서는 이를 반복 측정으로 분리된 수치가 아니라는 점을 언급했지만, 동시에 '두 요소만으로 거의 200ms가 단축된다'는 표현을 사실 서술로 유지하고 있어 근거의 정성적 한계를 충분히 반영하지 못한다.",
      "evidence_ids": [
        "E00070",
        "E00071"
      ],
      "review_stage": "evidence_usage",
      "review_request": "review-0-approved-evidence-S_limitations_p2-0"
