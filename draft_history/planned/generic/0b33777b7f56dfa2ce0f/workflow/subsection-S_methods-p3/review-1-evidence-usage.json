  "issues": [
    {
      "section_id": "S_methods",
      "severity": "error",
      "paragraph_id": "S_methods_p1",
      "reason": "근거 E00257, E00261, E00263은 모두 p68 figure 캡션에 기록된 현재 C++ 멀티스트림 구현의 방식(Task Parallelism, 64개 스트림, 1024개 처리, 수만 번 커널 호출, 약 8분)과 antenna_lirpa의 싱글 스트림·cuBLAS Batched GEMM·텐서 코어 활용 및 약 4배 비교, 그리고 방법 A의 3.2배 가속(25분→8분)과 한계선(7~8분, SM 포화)만 서술한다. 반면 초안 S_methods_p1은 측정 구간 분리(추론/bound 계산/검증), 타임스탬프 누적 방식, 신경망 크기 256-491-491-16, 배치 사이즈 1, CROWN 3가지 실행 방식(forward/forward+backward/backward_only), 입력 데이터셋·eps_list의 기존 신경망 검증팀 사용, 최적화 변경 사항과의 구분 등 근거를 벗어난 구현·설정·측정 절차 주장을 포함한다. 이 내용들은 제공된 근거(E00257, E00261, E00263)에서 직접 확인되지 않으므로 해당 근거에 귀속된 주장으로 볼 수 없다.",
      "evidence_ids": [
        "E00257",
        "E00261",
        "E00263"
      ],
      "review_stage": "evidence_usage",
      "review_request": "review-1-approved-evidence-S_methods_p1-0"
