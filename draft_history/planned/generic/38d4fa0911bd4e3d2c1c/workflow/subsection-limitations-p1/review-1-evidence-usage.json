    {
      "section_id": "limitations",
      "severity": "error",
      "paragraph_id": "limitations_p1",
      "reason": "근거 범위를 벗어난 수치·인과 주장",
      "evidence_ids": [
        "E00083",
        "E00029",
        "E00030",
        "E00277",
        "E00278"
      ],
      "review_stage": "evidence_usage",
