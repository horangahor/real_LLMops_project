# PDFs must retain their binary byte offsets on every checkout.
*.pdf binary

# Frozen evaluations and archive manifests bind the original bytes by SHA-256.
evaluation/extraction/** -text
evaluation/extraction/v3/current/evidence.json whitespace=cr-at-eol
evaluation/planning/** -text
evaluation/writing/pilots/** -text whitespace=cr-at-eol
# Preserve the frozen failed candidate's original trailing blank lines.
evaluation/writing/pilots/20261031-results/chapter-candidate.md whitespace=cr-at-eol,-blank-at-eof
archive/** -text
