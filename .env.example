# Copy this file to .env and enter your own API key. Never commit .env.
UPSTAGE_API_KEY=
SOLAR_MODEL=solar-pro4
# Automatic omission recovery per page: 1 for normal use, 5 for a deep audit.
# Unresolved items always remain visible and block drafting.
RESEARCH_MAX_RECOVERY_ROUNDS=1

# Optional: legacy Studio structure benchmark only; the direct Parse path needs no Agent ID.
STRUCTURE_AGENT_ID=agt_ZodDrwGVgFVrFBh6W8UiSY
STRUCTURE_CONFIG_ID=4

# Optional: copy your existing research-extraction Agent settings locally.
METHOD_RESULT_AGENT_ID=
METHOD_RESULT_CONFIG_ID=2
